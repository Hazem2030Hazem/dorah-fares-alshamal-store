# منع الوصول لـ package.json
<Files "package.json">
    Order allow,deny
    Deny from all
</Files>

# حماية الملفات الحساسة
<FilesMatch "\.(env|git|sql|md|log|py|apk|ts)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Headers أمنية أساسية
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP — كل inline JS أصبح خارجياً أو عبر data-* dispatcher.
    # JSON-LD inlined بس hash معتمده. style-src لسه فيه inline styles (مرحلة قادمة).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-9M2tNs9bah7nUbVPVh4hZr0xRz4s/ETlaAGSxyJYu0E' 'sha256-S6egZZkExj/flYQBOoaQQUJyqEryTYtwAKG6Dyz6mNY' https://cdn.jsdelivr.net https://cdn.moyasar.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://kcbmvxuzjlaooknwhqqb.supabase.co https://kcbmvxuzjlaooknwhqqb.functions.supabase.co https://api.moyasar.com; frame-src 'self' https://api.moyasar.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# منع تصفح المجلدات
Options -Indexes

# توحيد صفحات المنتجات في products.html
RewriteEngine On
RewriteRule ^products-printers\.html$ /products.html?category=printers [R=301,L]
RewriteRule ^products-computers\.html$ /products.html?category=computers [R=301,L]
RewriteRule ^products-ram\.html$ /products.html?category=ram [R=301,L]
RewriteRule ^products-hard-drives\.html$ /products.html?category=hard-drives [R=301,L]
RewriteRule ^products-accessories\.html$ /products.html?category=accessories [R=301,L]
RewriteRule ^products-cables\.html$ /products.html?category=cables [R=301,L]
RewriteRule ^products-projectors\.html$ /products.html?category=projectors [R=301,L]
RewriteRule ^products-ink\.html$ /products.html?category=ink [R=301,L]
RewriteRule ^products-food\.html$ /products.html?category=food [R=301,L]

# إجبار HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# حماية من Hotlinking للصور
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?alshamal-df\.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|svg)$ - [NC,F,L]

# ضغط الملفات
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# كاش المتصفح
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
